---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const projectSchema = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: project.data.title,
  description: project.data.summary,
  url: new URL(Astro.url.pathname, Astro.site).href,
  creator: { "@id": new URL("/#person", Astro.site).href },
};
---
<BaseLayout title={`${project.data.title} — a project by Andy David`} description={project.data.summary}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(projectSchema)} />
  <article class="page project-page" style={`--project-accent:${project.data.accent}`}>
    <a class="back" href="/projects/">← All work</a>
    <div class="project-heading">
      <div class="voxel" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
      <p class="eyebrow">{project.data.category} / {project.data.year}</p>
      <h1 class="page-title">
        {project.data.externalUrl ? <a href={project.data.externalUrl} target="_blank" rel="noreferrer">{project.data.title}</a> : project.data.title}
      </h1>
      <p class="page-intro">{project.data.summary}</p>
    </div>
    <dl>
      <div><dt>Role</dt><dd>{project.data.role}</dd></div>
      <div><dt>Status</dt><dd>{project.data.status}</dd></div>
      <div><dt>Material</dt><dd>{project.data.category}</dd></div>
    </dl>
    <div class="project-body"><Content /></div>
    {project.data.externalUrl && <a class="visit" href={project.data.externalUrl} target="_blank" rel="noreferrer">Visit {project.data.title} <span>↗</span></a>}
  </article>
</BaseLayout>

<style>
  .back { display: inline-block; margin-bottom: 54px; color: var(--faint); font: .59rem var(--mono); text-transform: uppercase; }
  .back:hover { color: var(--text); }
  .project-heading { position: relative; }
  .voxel { position: absolute; right: 4px; top: 0; display: grid; grid-template-columns: repeat(3, 13px); gap: 3px; transform: rotate(-3deg); }
  .voxel i { width: 13px; height: 13px; background: var(--project-accent); border: 1px solid color-mix(in srgb, var(--project-accent), #000 14%); }
  .voxel i:nth-child(2n) { opacity: .45; }
  .voxel i:nth-child(5) { transform: translateY(-4px); }
  dl { display: grid; grid-template-columns: repeat(3,1fr); margin: 56px 0 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  dl div { padding: 14px 3px; }
  dt { color: var(--faint); font: .55rem var(--mono); text-transform: uppercase; }
  dd { margin: 5px 0 0; font-size: .7rem; }
  .project-body { max-width: 560px; margin-top: 50px; color: var(--muted); font-size: .9rem; line-height: 1.8; }
  .project-body :global(p) { margin: 0 0 20px; }
  .project-body :global(a) { color: var(--text); text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 3px; }
  .project-body :global(a:hover) { text-decoration-color: currentColor; }
  .visit { margin-top: 30px; border: 1px solid var(--line-strong); background: var(--surface); display: flex; justify-content: space-between; padding: 14px 16px; border-radius: 8px; font-size: .72rem; }
  .visit:hover { border-color: var(--text); }
  @media (max-width: 520px) { dl { grid-template-columns: 1fr; } dl div + div { border-top: 1px solid var(--line); } }
</style>
