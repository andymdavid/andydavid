---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
const links = (await getCollection("links", ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Reading list — Andy David" description="An evolving reading list curated by Andy David.">
  <section class="page">
    <p class="eyebrow">Bookmarks / References</p>
    <h1 class="page-title">Reading list.</h1>
    <p class="page-intro">Books, essays, papers, and useful fragments worth returning to.</p>
    {links.length ? <div class="links-grid">
      {links.map((link, index) => (
        <a href={link.data.url} target="_blank" rel="noreferrer">
          <small>{String(index + 1).padStart(2, "0")} / {link.data.kind}</small>
          <strong>{link.data.title}</strong>
          <p>{link.data.note}</p>
          <span>↗</span>
        </a>
      ))}
    </div> : <div class="empty-state"><span>01</span><p>The shelf is empty for now.</p><small>I’ll start adding things once the shape of this list is clearer.</small></div>}
  </section>
</BaseLayout>

<style>
  .links-grid { margin-top: 56px; display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .links-grid a { min-height: 180px; padding: 22px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); position: relative; transition: background .15s ease; }
  .links-grid a:hover { background: var(--surface); }
  small { display: block; color: var(--faint); font: .55rem var(--mono); text-transform: uppercase; }
  strong { display: block; margin-top: 30px; font-size: .9rem; font-weight: 620; }
  p { margin: 8px 25px 0 0; color: var(--muted); font-size: .7rem; line-height: 1.55; }
  span { position: absolute; right: 18px; top: 18px; color: var(--faint); }
  .empty-state { margin-top: 56px; min-height: 180px; display: flex; flex-direction: column; justify-content: center; padding: 24px; border-block: 1px solid var(--line); }
  .empty-state span { position: static; font: .55rem var(--mono); }
  .empty-state p { margin: 22px 0 4px; color: var(--text); font-size: .9rem; }
  .empty-state small { color: var(--muted); font-size: .68rem; }
  @media (max-width: 520px) { .links-grid { grid-template-columns: 1fr; } }
</style>
