---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
}

const {
  title = "Andy David — venture designer and builder",
  description = "Andy David is a venture designer and co-founder working across AI agents, software, media, and physical ventures in Perth, Western Australia.",
  image = "/andy-david.webp",
  type = "website",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const siteId = new URL("/#website", Astro.site).href;
const personId = new URL("/#person", Astro.site).href;
const personDescription = "Andy David is a venture designer and co-founder working across AI agents, software, media, and physical ventures in Perth, Western Australia.";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": siteId,
      url: new URL("/", Astro.site).href,
      name: "Andy David",
      inLanguage: "en-AU",
      publisher: { "@id": personId },
    },
    {
      "@type": "WebPage",
      "@id": `${canonical.href}#webpage`,
      url: canonical.href,
      name: title,
      description,
      inLanguage: "en-AU",
      isPartOf: { "@id": siteId },
      about: { "@id": personId },
    },
    {
      "@type": "Person",
      "@id": personId,
      url: new URL("/about/", Astro.site).href,
      name: "Andy David",
      jobTitle: "Venture designer and co-founder",
      description: personDescription,
      image: new URL("/andy-david.webp", Astro.site).href,
      homeLocation: { "@type": "Place", name: "Perth, Western Australia" },
      knowsAbout: ["AI agents", "small business software", "product design", "venture design", "media", "physical products"],
      sameAs: [
        "https://github.com/andymdavid",
        "https://x.com/andymdavid",
        "https://www.linkedin.com/in/andymdavid/",
        "https://primal.net/andydavid",
        "https://www.youtube.com/@intelligencesnacks",
      ],
      worksFor: [
        { "@id": "https://otherstuff.ai/#organization" },
        { "@id": "https://offpistestudio.com/#organization" },
        { "@id": "https://cloudmodular.com.au/#organization" },
      ],
    },
    {
      "@type": "ProfilePage",
      "@id": new URL("/about/#profile-page", Astro.site).href,
      url: new URL("/about/", Astro.site).href,
      name: "About Andy David",
      mainEntity: { "@id": personId },
      isPartOf: { "@id": siteId },
    },
    {
      "@type": "Organization",
      "@id": "https://otherstuff.ai/#organization",
      name: "Other Stuff",
      url: "https://otherstuff.ai",
      founder: { "@id": personId },
    },
    {
      "@type": "Organization",
      "@id": "https://offpistestudio.com/#organization",
      name: "Off-Piste Studio",
      url: "https://offpistestudio.com",
      founder: { "@id": personId },
    },
    {
      "@type": "Organization",
      "@id": "https://cloudmodular.com.au/#organization",
      name: "Cloud Modular",
      url: "https://cloudmodular.com.au",
      founder: { "@id": personId },
    },
    {
      "@type": "PodcastSeries",
      "@id": "https://intelligencesnacks.com/#podcast",
      name: "Intelligence Snacks",
      url: "https://intelligencesnacks.com",
      description: "A podcast about how artificial intelligence is changing work, business, software, and entrepreneurship.",
      contributor: { "@id": personId },
      sameAs: "https://www.youtube.com/@intelligencesnacks",
    },
  ],
};
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content="Andy David" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="theme-color" content="#f2f1ec" />
    <link rel="canonical" href={canonical} />
    <link rel="describedby" href="/llms.txt" />
    <link rel="icon" href="/favicon.ico?v=2" sizes="any" />
    <link rel="icon" href="/andy-david.webp?v=2" type="image/webp" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:site_name" content="Andy David" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem("andy-theme");
        document.documentElement.dataset.theme = saved || "light";
      })();
    </script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <div class="site-shell">
      <Header />
      <main><slot /></main>
      <Footer />
    </div>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>(".theme-toggle");
      toggle?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        localStorage.setItem("andy-theme", next);
      });
    </script>
  </body>
</html>
