---
type ContributionDay = { contributionCount: number; date: string; weekday: number };
type ContributionWeek = { contributionDays: ContributionDay[] };
type Calendar = { totalContributions: number; weeks: ContributionWeek[] };

const githubToken = import.meta.env.GITHUB_TOKEN;
let calendar: Calendar | null = null;

if (githubToken) {
  try {
    const response = await fetch("https://api.github.com/graphql", {
      method: "POST",
      headers: {
        Authorization: `Bearer ${githubToken}`,
        "Content-Type": "application/json",
        "User-Agent": "andydavid.com",
      },
      body: JSON.stringify({
        query: `query($login: String!) {
          user(login: $login) {
            contributionsCollection {
              contributionCalendar {
                totalContributions
                weeks { contributionDays { contributionCount date weekday } }
              }
            }
          }
        }`,
        variables: { login: "andymdavid" },
      }),
    });

    if (response.ok) {
      const payload = await response.json();
      calendar = payload.data?.user?.contributionsCollection?.contributionCalendar ?? null;
    }
  } catch {
    calendar = null;
  }
}

const levelFor = (count: number) => count === 0 ? 0 : count < 3 ? 1 : count < 7 ? 2 : count < 14 ? 3 : 4;
---
{calendar && (
  <section class="github-activity">
    <div class="activity-heading">
      <h2>GitHub activity</h2>
      <a href="https://github.com/andymdavid" target="_blank" rel="me noreferrer">@andymdavid ↗</a>
    </div>
    <div class="calendar-scroll">
      <div class="calendar" aria-label={`${calendar.totalContributions.toLocaleString()} GitHub contributions in the last year`}>
        {calendar.weeks.map((week) => (
          <div class="week">
            {week.contributionDays.map((day) => (
              <i class={`level-${levelFor(day.contributionCount)}`} title={`${day.contributionCount} contributions on ${day.date}`}></i>
            ))}
          </div>
        ))}
      </div>
    </div>
    <p>{calendar.totalContributions.toLocaleString()} contributions in the last year</p>
  </section>
)}

<style>
  .github-activity { margin-top: 82px; }
  .activity-heading { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
  h2 { margin: 0; font-size: .8rem; font-weight: 650; }
  .activity-heading a { color: var(--faint); font: .61rem var(--mono); }
  .activity-heading a:hover { color: var(--text); }
  .calendar-scroll { overflow-x: auto; padding-bottom: 4px; scrollbar-width: thin; }
  .calendar { min-width: 635px; display: flex; gap: 3px; }
  .week { display: grid; grid-template-rows: repeat(7, 9px); gap: 3px; }
  .week i { width: 9px; height: 9px; border-radius: 2px; background: var(--text); }
  .level-0 { opacity: .07; }
  .level-1 { opacity: .18; }
  .level-2 { opacity: .34; }
  .level-3 { opacity: .58; }
  .level-4 { opacity: .9; }
  p { margin: 9px 0 0; color: var(--faint); font: .56rem var(--mono); text-transform: uppercase; }
</style>
