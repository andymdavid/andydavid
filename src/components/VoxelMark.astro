---
interface Props { small?: boolean }
const { small = false } = Astro.props;
---
<span class:list={["voxel-mark", { small }]} aria-hidden="true">
  <i></i><i></i><i></i><i></i><i></i><i></i><i></i>
</span>

<style>
  .voxel-mark { display: grid; grid-template-columns: repeat(3, 6px); grid-template-rows: repeat(3, 6px); gap: 2px; transform: rotate(-2deg); }
  .voxel-mark i { display: block; background: currentColor; }
  .voxel-mark i:nth-child(2) { grid-column: 2; }
  .voxel-mark i:nth-child(3) { grid-column: 1; grid-row: 2; opacity: .5; }
  .voxel-mark i:nth-child(4) { grid-column: 2; grid-row: 2; }
  .voxel-mark i:nth-child(5) { grid-column: 3; grid-row: 2; opacity: .22; }
  .voxel-mark i:nth-child(6) { grid-column: 2; grid-row: 3; opacity: .5; }
  .voxel-mark i:nth-child(7) { grid-column: 3; grid-row: 3; }
  .voxel-mark.small { grid-template-columns: repeat(3, 4px); grid-template-rows: repeat(3, 4px); gap: 1px; }
</style>
